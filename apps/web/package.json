{
  "name": "web",
  "version": "1.4.0",
  "private": true,
  "description": "Browser app that predicts game results from published Elo seeds and this season's results",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.reporter=lcov",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc src/index.ts",
    "backtest": "tsx scripts/backtest.ts"
  },
  "keywords": [],
  "author": "John Bolton <jambolo@users.noreply.github.com> (https://jambolo.github.io)",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "csv-parse": "^7.0.3",
    "luxon": "^3.7.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
